<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole application, and there is almost no more than this.

  Everything Akebia is arrives in the shared object named below. The only Java
  in the package is `AkebiaActivity`, and it exists for one reason: the system's
  file picker answers through `onActivityResult`, and `NativeActivity` does not
  pass that call on to native code.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.akebia">

    <!-- 26 is not a preference: `libaaudio`, which is how the sound comes out,
         appears in the NDK at that level and not before. -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- The link cable. Android refuses a socket to an application that has not
         asked for this, and it refuses it silently as far as the person holding
         the telephone is concerned: what they see is a connection that never
         happens. It covers a machine on the same house network just as much as
         one across the internet - Android draws no distinction between the two,
         and neither does a cable. It is not a permission anybody is asked to
         grant: it is declared here and given at install. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Where the saved games live. Android erases everything an application
         owns when it is uninstalled, and a saved game inside that folder goes
         with it: a hundred hours are lost to reinstalling the emulator. So the
         cartridges and their `.sav` are kept out in the shared storage, in
         `/sdcard/Akebia`, and reaching it is what these two ask for.

         They are two because Android changed how it is asked halfway through the
         range of telephones this runs on. Up to Android 10 it is the old runtime
         permission, granted in a dialog; `maxSdkVersion` retires it after that,
         where it no longer does anything. From Android 11 on, writing outside
         one's own folder means `MANAGE_EXTERNAL_STORAGE`, which no dialog grants:
         the user turns it on in the settings, and Akebia sends them there.

         Neither is required to play. Without them the emulator falls back to its
         own folder and everything works exactly as it did before - up until the
         day the application is uninstalled. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 10 only, and it is the reason the permission above is enough
         there: that release put every application under scoped storage, where
         the old permission stopped granting a path to write to, and left this
         flag as the way to say the old rules still apply. Android 11 ignores it
         outright, which is what `MANAGE_EXTERNAL_STORAGE` is for. -->
    <application android:label="Akebia" android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">

        <!-- `configChanges` lists what the activity survives. Without it Android
             destroys and rebuilds it on every rotation, and rebuilding it means
             running `android_main` again from scratch: the game would restart on
             turning the telephone. The window is told about the change instead,
             and the interface rearranges itself around the new shape.

             The orientation is deliberately not fixed: upright the controls go
             under the screen, turned they go on either side of it. -->
        <activity
            android:name=".AkebiaActivity"
            android:label="Akebia"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode">

            <!-- The library to load, without the `lib` prefix and without the
                 `.so`: it is `libakebia_android.so`, the `cdylib` that
                 `crates/akebia-android` produces. -->
            <meta-data android:name="android.app.lib_name" android:value="akebia_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
