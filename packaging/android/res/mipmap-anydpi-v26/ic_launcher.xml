<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon in two layers, which is what Android has wanted since version 8.

  The launcher masks it into whatever shape the telephone has decided on —a
  circle, a squircle, a rounded square— and moves the layers against each other
  when the icon is touched. A single flat picture would be cropped by that mask
  at the corners; in two layers, only the background is, and the flower is left
  well inside the part that always survives.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
